<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\VpkAddonConflictingDetailsView.axaml
     DataContext: VpkAddonConflictingDetailsViewModel.
     Differences:
       * CollectionConverters.IsEmpty / IsNotEmpty -> EmptyEnumerableToVisibilityConverter (receives the
         collection) and NotEmptyToVisibilityConverter (receives .Count, i.e. an integer).
       * "Command={Binding ...IgnoreConflictingFile}" + CommandParameter relied on ReactiveUI turning a
         method into a command; both are plain methods in P1, so the Click handlers below call them and read
         the file name from the clicked button's DataContext.
       * SelectableTextBlock -> TextBlock IsTextSelectionEnabled; DockPanel -> Grid.
       * Texts.Empty hint style (Classes=EmptyHint) -> explicit properties on each hint. -->
<UserControl
    x:Class="FireAxe.Views.VpkAddonConflictingDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FireAxe.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">

        <!--  conflicting addons  -->
        <Expander HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch"
            IsExpanded="True">
            <Expander.Header>
                <TextBlock Text="{x:Bind r:Texts.ConflictingAddons, Mode=OneTime}" />
            </Expander.Header>
            <Grid>
                <TextBlock
                    Margin="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{x:Bind r:Texts.Empty, Mode=OneTime}"
                    Visibility="{Binding ConflictingAddonWithFilesViewModels, Converter={StaticResource EmptyEnumerableToVisibilityConverter}}" />
                <ItemsControl
                    ItemsSource="{Binding ConflictingAddonWithFilesViewModels}"
                    Visibility="{Binding ConflictingAddonWithFilesViewModels.Count, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander HorizontalContentAlignment="Stretch" IsExpanded="False">
                                <Expander.Header>
                                    <controls:AddonRefView DataContext="{Binding AddonViewModel}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="2.5"
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Expander>

        <!--  conflicting files  -->
        <Expander HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch"
            IsExpanded="True">
            <Expander.Header>
                <TextBlock Text="{x:Bind r:Texts.ConflictingFiles, Mode=OneTime}" />
            </Expander.Header>
            <StackPanel Orientation="Vertical">
                <Button
                    Margin="2.5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding IgnoreAllConflictingFilesCommand}"
                    Content="{x:Bind r:Texts.IgnoreAll, Mode=OneTime}"
                    Visibility="{Binding ConflictingFileWithAddonsViewModels.Count, Converter={StaticResource NotEmptyToVisibilityConverter}}" />
                <Grid>
                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Bind r:Texts.Empty, Mode=OneTime}"
                        Visibility="{Binding ConflictingFileWithAddonsViewModels, Converter={StaticResource EmptyEnumerableToVisibilityConverter}}" />
                    <ItemsControl
                        ItemsSource="{Binding ConflictingFileWithAddonsViewModels}"
                        Visibility="{Binding ConflictingFileWithAddonsViewModels.Count, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander HorizontalContentAlignment="Stretch" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding File}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="1"
                                                Margin="2.5"
                                                VerticalAlignment="Center"
                                                Click="OnIgnoreConflictingFileClick"
                                                Content="{x:Bind r:Texts.Ignore, Mode=OneTime}" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding AddonViewModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2.5">
                                                    <controls:AddonRefView />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </Expander>

        <!--  conflict ignoring files  -->
        <Expander HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch"
            IsExpanded="True">
            <Expander.Header>
                <TextBlock Text="{x:Bind r:Texts.ConflictIgnoringFiles, Mode=OneTime}" />
            </Expander.Header>
            <StackPanel Orientation="Vertical">
                <Button
                    Margin="2.5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding RemoveAllConflictIgnoringFilesCommand}"
                    Content="{x:Bind r:Texts.RemoveAll, Mode=OneTime}"
                    Visibility="{Binding Addon.ConflictIgnoringFiles.Count, Converter={StaticResource NotEmptyToVisibilityConverter}}" />
                <Grid>
                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Bind r:Texts.Empty, Mode=OneTime}"
                        Visibility="{Binding Addon.ConflictIgnoringFiles, Converter={StaticResource EmptyEnumerableToVisibilityConverter}}" />
                    <ItemsControl
                        ItemsSource="{Binding Addon.ConflictIgnoringFiles}"
                        Visibility="{Binding Addon.ConflictIgnoringFiles.Count, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        IsTextSelectionEnabled="True"
                                        Text="{Binding}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="2.5"
                                        VerticalAlignment="Center"
                                        Click="OnRemoveConflictIgnoringFileClick"
                                        Content="{x:Bind r:Texts.Remove, Mode=OneTime}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
