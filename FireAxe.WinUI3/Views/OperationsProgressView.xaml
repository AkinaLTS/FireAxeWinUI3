<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\OperationsProgressView.axaml
     SelectableTextBlock -> TextBlock IsTextSelectionEnabled (WinUI 3)
     $parent[v:OperationsProgressView].Message / .DetailedMessages -> the UserControl's own properties (x:Bind) -->
<UserControl
    x:Class="FireAxe.Views.OperationsProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FireAxe.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    mc:Ignorable="d">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="5">
            <FontIcon
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="&#xE7BA;"
                Visibility="{x:Bind local:XBind.VisibleIf(HasFailedOperation), Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind Message, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Expander
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Header="{x:Bind r:Texts.Details, Mode=OneTime}"
            IsExpanded="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind DetailedMessages, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="2.5"
                                IsTextSelectionEnabled="True"
                                Text="{Binding}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>
    </Grid>
</UserControl>
