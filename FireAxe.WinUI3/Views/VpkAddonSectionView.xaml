<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\VpkAddonSectionView.axaml
     DataContext: VpkAddonViewModel.
     Differences: DockPanel rows -> Grid Auto/* rows; SelectableTextBlock -> TextBlock
     IsTextSelectionEnabled (WinUI has no SelectableTextBlock); Classes=PropertyName/PropertyValue ->
     explicit styles; the App.axaml "Expander { HorizontalAlignment: Stretch }" style selector has no WinUI
     equivalent, so the alignment is set on each Expander. -->
<UserControl
    x:Class="FireAxe.Views.VpkAddonSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    xmlns:views="using:FireAxe.Views"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <TextBlock Style="{StaticResource Heading1TextStyle}" Text="{x:Bind r:Texts.VpkInfo, Mode=OneTime}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.VersionColon, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding Info.Version}" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.TitleColon, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding Info.Title}" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.AuthorColon, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding Info.Author}" />
        </Grid>

        <TextBlock
            IsTextSelectionEnabled="True"
            Style="{StaticResource PropertyNameTextStyle}"
            Text="{x:Bind r:Texts.DescriptionColon, Mode=OneTime}" />
        <TextBlock
            IsTextSelectionEnabled="True"
            Text="{Binding Info.Description}"
            TextWrapping="Wrap" />

        <Expander
            Margin="0,5,0,5"
            HorizontalAlignment="Stretch">
            <Expander.Header>
                <TextBlock Style="{StaticResource Heading1TextStyle}" Text="{x:Bind r:Texts.ConflictingDetails, Mode=OneTime}" />
            </Expander.Header>
            <views:VpkAddonConflictingDetailsView DataContext="{Binding ConflictingDetailsViewModel}" />
        </Expander>
    </StackPanel>
</UserControl>
