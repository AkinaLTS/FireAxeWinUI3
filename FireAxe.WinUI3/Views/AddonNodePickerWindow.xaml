<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNodePickerWindow.axaml -->
<host:HostedPage
    xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.AddonNodePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="using:FireAxe.Resources">
    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource NativePageTitleTextStyle}" Text="{x:Bind r:Texts.Select, Mode=OneTime}" />
    <Grid Grid.Row="1" Padding="0" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <local:AddonNodeExplorerView xmlns:local="using:FireAxe.Views" x:Name="explorerView" IsAddonNodeViewEnabled="False" IsSingleSelectionEnabled="{x:Bind IsSingleSelectionEnabled, Mode=OneTime}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{x:Bind r:Texts.Cancel, Mode=OneTime}" Click="OnCancelClick" />
            <Button Style="{StaticResource AccentButtonStyle}" Content="{x:Bind r:Texts.Confirm, Mode=OneTime}" Command="{x:Bind ViewModel.ConfirmCommand, Mode=OneTime}" />
        </StackPanel>
    </Grid>
    </Grid>
</host:HostedPage>