<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNodeView.axaml
     DataContext: AddonNodeViewModel (the explorer hands it over; section views are created in code-behind).
     Structural differences from Avalonia:
       * DockPanel + Classes="PropertyRow" -> Grid with an Auto/* column pair, plus the PropertyName /
         PropertyValue text styles (WinUI has neither DockPanel nor class selectors).
       * <SelectableTextBlock> -> TextBlock IsTextSelectionEnabled="True".
       * The ExceptionExplainer DataTemplate the Alt view declared is gone: WinUI shows exceptions through
         IDialogService, and P1 moved that decision into the ViewModels (see P1 notes).
       * Buttons bind Click handlers instead of Command: the P1 view models expose Check / ClearCaches /
         ShowInFileExplorer as methods, not ICommand properties. -->
<UserControl
    x:Class="FireAxe.Views.AddonNodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:FireAxe.Views.Controls"
    xmlns:controls="using:FireAxe.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FireAxe.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical" Spacing="12">

        <!--  image  -->
        <Border Margin="5" Style="{StaticResource CardBorderStyle}">
            <Grid Margin="10">
                <controls:AddonIconView ImageSize="250" SpecialIconSize="150" />
            </Grid>
        </Border>

        <!--  name  -->
        <controls:EditableTextBlock
            x:Name="nameEditingControl"
            HorizontalAlignment="Center"
            FontSize="16"
            FontWeight="Bold"
            Submitting="OnNameSubmitting"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Value="{Binding Addon.Name}" />

        <!--  enable button  -->
        <StackPanel
            Margin="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                Text="{x:Bind r:Texts.EnabledOrDisabled, Mode=OneTime}" />
            <controls:AddonNodeEnableButton />
        </StackPanel>

        <Border Style="{StaticResource NativeCardStyle}"><StackPanel Spacing="4">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind r:NativeUiTexts.Details, Mode=OneTime}" />
        <!--  path  -->
        <Grid
            Margin="0,5,0,5"
            Visibility="{Binding Addon.Group, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=notnull}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.PathColon, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding Addon.NodePath}"
                TextWrapping="Wrap" />
        </Grid>

        <!--  parent group  -->
        <Grid
            Margin="0,5,0,5"
            Visibility="{Binding Addon.Group, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=notnull}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.ParentGroupColon, Mode=OneTime}" />
            <!--  DataContext is set by the code-behind (a converter cannot own the child view model's
                  Activate / Deactivate lifetime).  -->
            <controls:AddonRefView
                x:Name="parentGroupRefView"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>

        <!--  priority  -->
        <Grid Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.Priority, Mode=OneTime}" />
            <controls:EditableTextBlock
                x:Name="priorityEditingControl"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Submitting="OnPrioritySubmitting"
                Value="{Binding Priority}" />
        </Grid>

        <!--  global priority  -->
        <Grid Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.GlobalPriority, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding Addon.PriorityInHierarchy}" />
        </Grid>

        </StackPanel></Border>
        <!--  tags  -->
        <Border
            Margin="0,5,0,5"
            Style="{StaticResource Level1BorderStyle}">
            <StackPanel Orientation="Vertical" Spacing="12">
                <StackPanel
                    Margin="0,5,0,5"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind r:Texts.Tags, Mode=OneTime}" />
                    <Button x:Name="editTagButton" Click="OnEditTagButtonClick" AutomationProperties.Name="{x:Bind r:Texts.TagEditor, Mode=OneTime}">
                        <ctl:IconView Data="{x:Bind local:Icons.Edit, Mode=OneTime}" />
                    </Button>
                </StackPanel>

                <Grid>
                    <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding Addon.TagsInHierarchy}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5">
                                    <controls:AddonTagView />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Text="{x:Bind r:Texts.Empty, Mode=OneTime}"
                        Visibility="{Binding Addon.TagsInHierarchy, Converter={StaticResource EmptyEnumerableToVisibilityConverter}, FallbackValue=Visible}" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  dependencies  -->
        <Expander
            Margin="0,5,0,5"
            HorizontalAlignment="Stretch"
            IsExpanded="False">
            <Expander.Header>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind r:Texts.Dependencies, Mode=OneTime}" />
            </Expander.Header>
            <local:AddonNodeDependenciesView DataContext="{Binding DependenciesViewModel}" />
        </Expander>

        <!--  file size  -->
        <Grid
            Margin="0,5,0,5"
            Visibility="{Binding Addon.FileSize, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=notnull}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.FileSizeColon, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding Addon.FileSize, Converter={StaticResource ReadableBytesConverter}}" />
        </Grid>

        <!--  creation time  -->
        <Grid Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.CreationTimeColon, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding Addon.CreationTime, Converter={StaticResource LocalDateTimeConverter}}" />
        </Grid>

        <!--  buttons  -->
        <Expander HorizontalAlignment="Stretch" Header="{x:Bind r:Texts.Operations, Mode=OneTime}"><StackPanel Spacing="8">
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnCheckButtonClick"
                Content="{x:Bind r:Texts.Check, Mode=OneTime}" />
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnClearCachesButtonClick"
                Content="{x:Bind r:Texts.ClearCaches, Mode=OneTime}" />
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnShowInFileExplorerButtonClick"
                Content="{x:Bind r:Texts.ShowInFileExplorer, Mode=OneTime}" />
            <Button
                x:Name="customizeImageButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnCustomizeImageButtonClick"
                Content="{x:Bind r:Texts.CustomizePreviewImage, Mode=OneTime}" />
        </StackPanel></Expander>

        <!--  advanced panel  -->
        <Expander
            Margin="0,5,0,5"
            HorizontalAlignment="Stretch"
            IsExpanded="False">
            <Expander.Header>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind r:Texts.AdvancedPanel, Mode=OneTime}" />
            </Expander.Header>

            <StackPanel Orientation="Vertical" Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource PropertyNameTextStyle}"
                        Text="ID" />
                    <controls:EditableTextBlock
                        x:Name="idEditingControl"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Submitting="OnAddonIdSubmitting"
                        TextAlignment="Right"
                        Value="{Binding AddonIdString}" />
                </Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind r:Texts.ChangeIdNote, Mode=OneTime}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <!--  checking hint  -->
        <TextBlock
            Margin="0,5,0,5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{x:Bind r:Texts.Checking, Mode=OneTime}"
            Visibility="{Binding Addon.CheckTask, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=notnull, FallbackValue=Collapsed}" />

        <!--  problems  -->
        <Border
            Margin="0,5,0,5"
            BorderBrush="{StaticResource FireAxeWarningBrush}"
            Style="{StaticResource Level1BorderStyle}"
            Visibility="{Binding Addon.Problems.Count, Converter={StaticResource NotEmptyToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Vertical" Spacing="12">
                <TextBlock
                    Margin="0,5,0,5"
                    Foreground="{StaticResource FireAxeWarningBrush}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind r:Texts.Problems, Mode=OneTime}" />

                <ItemsControl ItemsSource="{Binding Addon.Problems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Margin="0,5,0,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource FireAxeWarningBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{Binding Converter={StaticResource ObjectExplanationConverter}}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  section views (filled by the code-behind)  -->
        <StackPanel x:Name="sectionViewContainerControl" Orientation="Vertical" />
    </StackPanel>
</UserControl>
