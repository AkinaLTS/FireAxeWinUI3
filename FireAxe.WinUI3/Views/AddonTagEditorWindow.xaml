<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonTagEditorWindow.axaml -->
<host:HostedPage
    xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.AddonTagEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="using:FireAxe.Resources"
    Title="{x:Bind r:Texts.TagEditor, Mode=OneTime}">
    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource NativePageTitleTextStyle}" Text="{x:Bind r:Texts.TagEditor, Mode=OneTime}" />
    <Grid Grid.Row="1" Padding="0" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Margin="5" Text="{x:Bind ViewModel.Addon.Name, Mode=OneWay}" />
        <Grid Grid.Row="1" ColumnSpacing="5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListView x:Name="tagsList" ItemsSource="{x:Bind ViewModel.Addon.Tags, Mode=OneWay}" SelectionMode="Multiple" />
            <StackPanel Grid.Column="1" Spacing="5">
                <Button Content="{x:Bind r:Texts.Add, Mode=OneTime}" Command="{x:Bind ViewModel.AddCommand, Mode=OneTime}" />
                <Button Content="{x:Bind r:Texts.Delete, Mode=OneTime}" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneTime}" />
                <Border Height="10" />
                <Button Content="{x:Bind r:Texts.MoveUp, Mode=OneTime}" Command="{x:Bind ViewModel.MoveUpCommand, Mode=OneTime}" />
                <Button Content="{x:Bind r:Texts.MoveDown, Mode=OneTime}" Command="{x:Bind ViewModel.MoveDownCommand, Mode=OneTime}" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</host:HostedPage>