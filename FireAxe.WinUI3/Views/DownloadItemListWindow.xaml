<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\DownloadItemListWindow.axaml -->
<host:HostedPage
    xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.DownloadItemListWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FireAxe.Views"
    xmlns:r="using:FireAxe.Resources"
    Title="{x:Bind r:Texts.DownloadList, Mode=OneTime}">
    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{x:Bind r:Texts.DownloadList, Mode=OneTime}" Style="{StaticResource NativePageTitleTextStyle}" />
        <TextBlock Grid.Row="1" Text="{x:Bind r:NativeUiTexts.DownloadsDescription, Mode=OneTime}" Style="{StaticResource NativeSubtitleTextStyle}" />
        <!-- A finite host lets the child ListView own scrolling and virtualization. -->
        <Border x:Name="downloadsHost" Grid.Row="2" Style="{StaticResource NativeCardStyle}" Padding="0" />
    </Grid>
</host:HostedPage>
