<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\DownloadItemView.axaml
     DataContext: DownloadItemViewModel.
     Differences forced by WinUI 3:
       * MultiBinding + StringFormat ("{0}/{1}") does not exist -> two TextBlocks and a literal separator.
       * ProgressBar.ShowProgressText does not exist -> the downloaded/total text above the bar already shows
         the numbers, so no progress text is drawn inside the bar.
       * "Width={Binding #progressBar.Width}" -> the text block simply stretches with the column.
       * TextWrapping=WrapWithOverflow -> Wrap (WinUI has no WrapWithOverflow).
       * "IsVisible={Binding !IsCompleted}" -> VisibleWhenFalseConverter.
       * Grid.Styles "Button { Background: Transparent }" -> explicit styles on the three buttons. -->
<UserControl
    x:Class="FireAxe.Views.DownloadItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:FireAxe.Views.Controls"
    xmlns:views="using:FireAxe.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  progress bar and status  -->
        <StackPanel
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center">
            <TextBlock
                Margin="5"
                MaxLines="2"
                Text="{Binding FileName}"
                TextAlignment="Left"
                TextWrapping="Wrap" />
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <TextBlock Text="{Binding DownloadedBytesReadable}" />
                    <TextBlock Text="/" />
                    <TextBlock Text="{Binding TotalBytesReadable}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding EtaReadable}"
                    TextAlignment="Center" />
                <TextBlock
                    Grid.Column="2"
                    Text="{Binding DownloadSpeedReadable}"
                    TextAlignment="Right" />
            </Grid>
            <ProgressBar
                x:Name="progressBar"
                Maximum="{Binding TotalBytes}"
                Minimum="0"
                Value="{Binding DownloadedBytes}"
                Visibility="{Binding IsProgressAvailable, Converter={StaticResource VisibleWhenTrueConverter}}" />
            <TextBlock
                Text="{x:Bind r:Texts.PreparingMessage, Mode=OneTime}"
                TextAlignment="Left"
                Visibility="{Binding IsPreparing, Converter={StaticResource VisibleWhenTrueConverter}}" />
        </StackPanel>

        <!--  buttons  -->
        <Grid
            Grid.Column="1"
            Margin="5"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Background="Transparent"
                Command="{Binding ResumeCommand}"
                Visibility="{Binding IsResumeable, Converter={StaticResource VisibleWhenTrueConverter}}">
                <ctl:IconView Data="{x:Bind views:Icons.Play, Mode=OneTime}" />
            </Button>
            <Button
                Grid.Column="0"
                Background="Transparent"
                Command="{Binding PauseCommand}"
                Visibility="{Binding IsPauseable, Converter={StaticResource VisibleWhenTrueConverter}}">
                <ctl:IconView Data="{x:Bind views:Icons.Pause, Mode=OneTime}" />
            </Button>
            <Button
                Grid.Column="1"
                Background="Transparent"
                Command="{Binding CancelCommand}"
                Visibility="{Binding IsCompleted, Converter={StaticResource VisibleWhenFalseConverter}}">
                <ctl:IconView Data="{x:Bind views:Icons.Dismiss, Mode=OneTime}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
