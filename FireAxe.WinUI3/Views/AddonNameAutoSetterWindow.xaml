<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNameAutoSetterWindow.axaml -->
<host:HostedPage
    xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.AddonNameAutoSetterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:FireAxe.Views.Controls"
    xmlns:r="using:FireAxe.Resources"
    Title="{x:Bind r:Texts.AddonNameAutoSetter, Mode=OneTime}">
    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource NativePageTitleTextStyle}" Text="{x:Bind r:Texts.AddonNameAutoSetter, Mode=OneTime}" />
    <Grid Grid.Row="1" Padding="0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="{x:Bind r:Texts.Start, Mode=OneTime}" Command="{x:Bind ViewModel.StartCommand, Mode=OneTime}" />
            <Button Content="{x:Bind r:Texts.RetryAll, Mode=OneTime}" Command="{x:Bind ViewModel.RetryAllCommand, Mode=OneTime}" />
            <Button Content="{x:Bind r:Texts.RemoveAll, Mode=OneTime}" Command="{x:Bind ViewModel.RemoveAllCommand, Mode=OneTime}" />
            <Button Content="{x:Bind r:Texts.ApplyAll, Mode=OneTime}" Command="{x:Bind ViewModel.ApplyAllCommand, Mode=OneTime}" />
            <CheckBox Content="{x:Bind r:Texts.ForceUseWorkshopTitle, Mode=OneTime}" IsChecked="{x:Bind ViewModel.ForceUseWorkshopTitle, Mode=TwoWay}" VerticalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{x:Bind r:Texts.Targets, Mode=OneTime}" />
            <Button Grid.Column="1" Content="{x:Bind r:Texts.AddTargets, Mode=OneTime}" Click="OnAddTargetsClick" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{x:Bind ViewModel.TargetAddonViewModels, Mode=OneWay}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="3" Padding="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ctl:AddonRefView Width="240" ShowEnableButton="False" />
                                <Button Content="{x:Bind r:Texts.Remove, Mode=OneTime}" Click="OnRemoveTargetClick" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.JobViewModels, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" ColumnSpacing="8" RowSpacing="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ctl:AddonRefView Grid.RowSpan="2" DataContext="{Binding}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding TargetName}" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Content="{x:Bind r:Texts.Apply, Mode=OneTime}" Command="{Binding ApplyCommand}" />
                            <Button Content="{x:Bind r:Texts.Remove, Mode=OneTime}" Click="OnRemoveJobClick" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SetNameErrorMessage}" TextWrapping="Wrap"
                                   Visibility="{Binding IsFailed, Converter={StaticResource VisibleWhenTrueConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
    </Grid>
</host:HostedPage>