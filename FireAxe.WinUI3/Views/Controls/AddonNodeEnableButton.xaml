<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNodeEnableButton.axaml
     DataContext: AddonNodeSimpleViewModel. The glyph and its colour are chosen in the code-behind from
     EnableState (Alt did the same in WhenActivated). -->
<UserControl
    x:Class="FireAxe.Views.Controls.AddonNodeEnableButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:FireAxe.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        x:Name="button"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="Transparent"
        Command="{Binding ToggleEnabledCommand}">
        <ctl:IconView
            x:Name="icon"
            Width="25"
            Height="25"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Stroke="{StaticResource FireAxeEnableButtonStrokeBrush}"
            StrokeThickness="0.5" />
    </Button>
</UserControl>
