<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Controls\EditableTextBlock.axaml
     Avalonia TemplatedControl + ControlTheme -> WinUI UserControl with named parts (no generic.xaml
     registration needed, see P0 §S5). The PART_ names are kept; the code-behind drives them directly.
     The Alt theme had no tooltips on the three buttons, so neither does this one. -->
<UserControl
    x:Class="FireAxe.Views.Controls.EditableTextBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:FireAxe.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FireAxe.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <!-- ============================ display ============================ -->
        <Grid x:Name="PART_DisplayView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="PART_TextBlock"
                VerticalAlignment="Center"
                IsTextSelectionEnabled="True"
                TextTrimming="CharacterEllipsis" />

            <Button
                x:Name="PART_EditButton"
                Grid.Column="1"
                MinWidth="0"
                Padding="4,2"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="OnEditButtonClick"
                Opacity="0.45">
                <ctl:IconView Width="12" Height="12" Data="{x:Bind local:Icons.Edit, Mode=OneTime}" />
            </Button>
        </Grid>

        <!-- ============================ editor ============================ -->
        <Grid x:Name="PART_EditView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="PART_TextBox"
                Grid.Column="0"
                VerticalAlignment="Center"
                TextWrapping="NoWrap" />

            <Button
                x:Name="PART_SubmitButton"
                Grid.Column="1"
                MinWidth="0"
                Padding="4,2"
                VerticalAlignment="Center"
                Click="OnSubmitButtonClick">
                <ctl:IconView Width="12" Height="12" Data="{x:Bind local:Icons.Checkmark, Mode=OneTime}" />
            </Button>

            <Button
                x:Name="PART_CancelButton"
                Grid.Column="2"
                MinWidth="0"
                Padding="4,2"
                VerticalAlignment="Center"
                Click="OnCancelButtonClick">
                <ctl:IconView Width="12" Height="12" Data="{x:Bind local:Icons.Dismiss, Mode=OneTime}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
