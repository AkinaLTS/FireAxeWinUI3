<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNodeTileView.axaml
     DataContext of the content is AddonNodeListItemViewModel (see AddonNodeListItemViewModelBinder).
     Difference: the Alt view read the tile edge from the DynamicResource "AddonTileSize", which the explorer
     mutated at run time. WinUI 3 has no DynamicResource, so the size is an ImageSize property on this control
     and the explorer applies it together with its ItemsWrapGrid metrics. -->
<UserControl
    x:Class="FireAxe.Views.Controls.AddonNodeTileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ctl="using:FireAxe.Views.Controls"
    xmlns:local="using:FireAxe.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:my="using:FireAxe.Views.Controls"
    mc:Ignorable="d">

    <Grid
        x:Name="rootGrid"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid
                Margin="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <my:AddonIconView x:Name="iconView" />
            </Grid>

            <Grid Height="30">
                <TextBlock
                    MaxWidth="{x:Bind ImageSize, Mode=OneWay}"
                    MaxLines="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    IsTextSelectionEnabled="False"
                    IsHitTestVisible="False"
                    Text="{Binding Addon.Name}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </StackPanel>

        <my:AddonNodeEnableButton HorizontalAlignment="Right" VerticalAlignment="Top" />

        <ctl:IconView
            Width="22"
            Height="22"
            Margin="5"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Data="{x:Bind local:Icons.Warning, Mode=OneTime}"
            Foreground="{StaticResource FireAxeWarningBrush}"
            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
            StrokeThickness="0.5"
            Visibility="{Binding Addon.Problems.Count, Converter={StaticResource NotEmptyToVisibilityConverter}, FallbackValue=Collapsed}" />
    </Grid>
</UserControl>
