<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNodeDependenciesView.axaml
     DataContext: AddonNodeDependenciesViewModel (set by AddonNodeView's Dependencies expander).
     Differences:
       * DockPanel -> Grid (*/Auto) so the remove button keeps its natural width on the right.
       * "Command={Binding Remove}" relied on ReactiveUI turning a method into a command; Remove() is a
         plain method in P1, so the Click handler calls it.
       * The item template uses classic bindings because the item type is a nested class
         (AddonNodeDependenciesViewModel.DependencyViewModel), which x:Bind's x:DataType cannot name; the
         dismiss icon is therefore a FontIcon instead of the shared PathIcon geometry. -->
<UserControl
    x:Class="FireAxe.Views.AddonNodeDependenciesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FireAxe.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Button
                x:Name="addDependencyButton"
                Click="OnAddDependencyButtonClick"
                Content="{x:Bind r:Texts.Add, Mode=OneTime}" />
            <Border Width="10" />
            <Button
                x:Name="enableAllDependenciesButton"
                Click="OnEnableAllDependenciesButtonClick"
                Content="{x:Bind r:Texts.EnableAll, Mode=OneTime}" />
        </StackPanel>

        <Border Height="15" />

        <ItemsControl ItemsSource="{Binding DependencyViewModels}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="5"
                        Padding="2.5"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:AddonRefView
                                Grid.Column="0"
                                HorizontalAlignment="Left" />

                            <Button
                                Grid.Column="1"
                                Background="Transparent"
                                Click="OnRemoveDependencyButtonClick">
                                <FontIcon FontSize="12" Glyph="&#xE10A;" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
