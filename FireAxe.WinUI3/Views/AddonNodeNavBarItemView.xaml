<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNodeNavBarItemView.axaml
     DataContext: AddonNodeNavBarItemViewModel.
     Difference: "Command={Binding Goto}" relied on ReactiveUI turning a method into a command; Goto() is a
     plain method in P1, so the button calls it from a Click handler. -->
<UserControl
    x:Class="FireAxe.Views.AddonNodeNavBarItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:FireAxe.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:FireAxe.Views"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal">
        <ctl:IconView
            Width="15"
            Height="15"
            Data="{x:Bind views:Icons.ArrowRight, Mode=OneTime}" />
        <Button Click="OnGotoButtonClick">
            <TextBlock Text="{Binding AddonGroup.Name}" />
        </Button>
    </StackPanel>
</UserControl>
