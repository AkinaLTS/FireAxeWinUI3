<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\DownloadItemListView.axaml -->
<UserControl
    x:Class="FireAxe.Views.DownloadItemListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FireAxe.Views"
    xmlns:r="using:FireAxe.Resources">
    <Grid>
        <ListView
            x:Name="downloadsList"
            ItemsSource="{x:Bind ViewModel.DownloadItemViewModels, Mode=OneWay}"
            SelectionMode="Multiple"
            SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <views:DownloadItemView />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="{x:Bind r:Texts.Pause, Mode=OneTime}" Command="{x:Bind ViewModel.PauseCommand, Mode=OneTime}" />
                    <MenuFlyoutItem Text="{x:Bind r:Texts.Resume, Mode=OneTime}" Command="{x:Bind ViewModel.ResumeCommand, Mode=OneTime}" />
                    <MenuFlyoutItem Text="{x:Bind r:Texts.Cancel, Mode=OneTime}" Command="{x:Bind ViewModel.CancelCommand, Mode=OneTime}" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>
        <TextBlock
            Text="{x:Bind r:Texts.Empty, Mode=OneTime}"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="20"
            IsHitTestVisible="False"
            Visibility="{Binding DownloadItemViewModels.Count, Converter={StaticResource ZeroToVisibilityConverter}, Mode=OneWay}" />
    </Grid>
</UserControl>
