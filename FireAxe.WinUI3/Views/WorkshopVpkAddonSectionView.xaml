<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\WorkshopVpkAddonSectionView.axaml
     DataContext: WorkshopVpkAddonViewModel.
     Differences:
       * "Command={Binding OpenWorkshopPage}" relied on ReactiveUI turning a method into a command;
         OpenWorkshopPage() is a plain method in P1, so it is called from a Click handler.
       * The App.axaml "Button { Stretch / Center }" style selector has no WinUI equivalent -> explicit
         HorizontalAlignment/HorizontalContentAlignment on the three buttons.
       * StackPanel.Styles for Expander is not needed here (no Expander in the Alt layout).
       * IsChecked="{Binding WorkshopAddon.IsAutoUpdate}" must be TwoWay (WinUI bindings default to OneWay).
       * ObjectConverters.IsNotNull -> NullToVisibilityConverter (parameter notnull).
       * SelectableTextBlock -> TextBlock IsTextSelectionEnabled; the 11-row Grid is kept as in Alt. -->
<UserControl
    x:Class="FireAxe.Views.WorkshopVpkAddonSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FireAxe.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    xmlns:views="using:FireAxe.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  title, buttons  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Vertical">
            <TextBlock Style="{StaticResource Heading1TextStyle}" Text="{x:Bind r:Texts.Workshop, Mode=OneTime}" />

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnOpenWorkshopPageClick"
                Content="{x:Bind r:Texts.OpenWorkshopPage, Mode=OneTime}" />
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding ApplyTagsFromWorkshopCommand}"
                Content="{x:Bind r:Texts.ApplyTagsFromWorkshop, Mode=OneTime}" />
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Command="{Binding DeleteRedundantVpkFilesCommand}"
                Content="{x:Bind r:Texts.DeleteRedundantVpkFiles, Mode=OneTime}" />
        </StackPanel>

        <!--  item id  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource PropertyNameTextStyle}"
            Text="{x:Bind r:Texts.ItemId, Mode=OneTime}" />
        <controls:EditableTextBlock
            x:Name="itemIdEditingControl"
            Grid.Row="1"
            Grid.Column="1"
            Submitting="OnItemIdSubmitting"
            Display="{Binding DisplayItemId}"
            Value="{Binding ItemId}"
            Watermark="{x:Bind r:Texts.InputPublishedFileIdHint, Mode=OneTime}" />

        <!--  auto update strategy  -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Style="{StaticResource PropertyNameTextStyle}"
            Text="{x:Bind r:Texts.AutoUpdateStrategy, Mode=OneTime}" />
        <CheckBox
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsChecked="{Binding WorkshopAddon.IsAutoUpdate, Mode=TwoWay}"
            IsThreeState="True" />

        <!--  download item  -->
        <StackPanel
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,5,0,5"
            Visibility="{Binding DownloadItemViewModel, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=notnull}">
            <TextBlock Style="{StaticResource PropertyNameTextStyle}" Text="{x:Bind r:Texts.Download, Mode=OneTime}" />
            <views:DownloadItemView DataContext="{Binding DownloadItemViewModel}" />
        </StackPanel>

        <!--  published file details  -->
        <Grid
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,5,0,5"
                Style="{StaticResource Heading1TextStyle}"
                Text="{x:Bind r:Texts.PublishedFileDetails, Mode=OneTime}" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.TitleColon, Mode=OneTime}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding PublishedFileDetails.Title}" />

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.TagsColon, Mode=OneTime}" />
            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                IsTextSelectionEnabled="True"
                Text="{Binding WorkshopTagsString}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.DescriptionColon, Mode=OneTime}" />
            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                IsTextSelectionEnabled="True"
                Text="{Binding PublishedFileDetails.Description}"
                TextWrapping="Wrap" />

            <TextBlock
                Grid.Row="6"
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.ViewsColon, Mode=OneTime}" />
            <TextBlock
                Grid.Row="6"
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding PublishedFileDetails.Views}" />

            <TextBlock
                Grid.Row="7"
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.SubscriptionsColon, Mode=OneTime}" />
            <TextBlock
                Grid.Row="7"
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding PublishedFileDetails.Subscriptions}" />

            <TextBlock
                Grid.Row="8"
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.FavoritesColon, Mode=OneTime}" />
            <TextBlock
                Grid.Row="8"
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding PublishedFileDetails.Favorited}" />

            <TextBlock
                Grid.Row="9"
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.LifetimeSubscriptionsColon, Mode=OneTime}" />
            <TextBlock
                Grid.Row="9"
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding PublishedFileDetails.LifetimeSubscriptions}" />

            <TextBlock
                Grid.Row="10"
                Grid.Column="0"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyNameTextStyle}"
                Text="{x:Bind r:Texts.LifetimeFavoritesColon, Mode=OneTime}" />
            <TextBlock
                Grid.Row="10"
                Grid.Column="1"
                IsTextSelectionEnabled="True"
                Style="{StaticResource PropertyValueTextStyle}"
                Text="{Binding PublishedFileDetails.LifetimeFavorited}" />
        </Grid>
    </Grid>
</UserControl>
