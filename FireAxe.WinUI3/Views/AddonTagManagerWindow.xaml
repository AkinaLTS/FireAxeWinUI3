<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonTagManagerWindow.axaml -->
<host:HostedPage
    xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.AddonTagManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="using:FireAxe.Resources"
    Title="{x:Bind r:Texts.TagManager, Mode=OneTime}">
    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource NativePageTitleTextStyle}" Text="{x:Bind r:Texts.TagManager, Mode=OneTime}" />
    <Grid Grid.Row="1" Padding="0" ColumnSpacing="8" RowSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Button Content="{x:Bind r:Texts.Refresh, Mode=OneTime}" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneTime}" />
        <ListView x:Name="tagsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.MainWindowViewModel.AddonRoot.CustomTags, Mode=OneWay}" SelectionMode="Multiple" />
        <StackPanel Grid.RowSpan="2" Grid.Column="1" Spacing="6">
            <Button Content="{x:Bind r:Texts.New, Mode=OneTime}" Command="{x:Bind ViewModel.AddCommand, Mode=OneTime}" />
            <Button Content="{x:Bind r:Texts.Rename, Mode=OneTime}" Command="{x:Bind ViewModel.RenameCommand, Mode=OneTime}" />
            <Button Content="{x:Bind r:Texts.Delete, Mode=OneTime}" Command="{x:Bind ViewModel.DeleteCommand, Mode=OneTime}" />
            <Button Content="{x:Bind r:Texts.DeleteCompletely, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind r:Texts.DeleteTagCompletelyTip, Mode=OneTime}" Command="{x:Bind ViewModel.DeleteCompletelyCommand, Mode=OneTime}" />
            <Button Content="{x:Bind r:Texts.MoveUp, Mode=OneTime}" Command="{x:Bind ViewModel.MoveUpCommand, Mode=OneTime}" />
            <Button Content="{x:Bind r:Texts.MoveDown, Mode=OneTime}" Command="{x:Bind ViewModel.MoveDownCommand, Mode=OneTime}" />
        </StackPanel>
    </Grid>
    </Grid>
</host:HostedPage>