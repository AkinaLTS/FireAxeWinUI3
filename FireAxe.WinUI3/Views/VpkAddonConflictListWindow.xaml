<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\VpkAddonConflictListWindow.axaml -->
<host:HostedPage xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.VpkAddonConflictListWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:FireAxe.Views.Controls" xmlns:details="using:FireAxe.Views" xmlns:r="using:FireAxe.Resources" Title="{x:Bind r:Texts.VpkConflictList, Mode=OneTime}">
    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource NativePageTitleTextStyle}" Text="{x:Bind r:Texts.VpkConflictList, Mode=OneTime}" />
        <Grid x:Name="root" Padding="0" RowSpacing="8" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TabView x:Name="conflictTabs" IsAddTabButtonVisible="False">
                    <TabView.TabItems>
                        <TabViewItem Header="{x:Bind r:Texts.ConflictingAddons, Mode=OneTime}" />
                        <TabViewItem Header="{x:Bind r:Texts.ConflictingFiles, Mode=OneTime}" />
                    </TabView.TabItems>
                </TabView>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind r:Texts.RefreshingHint, Mode=OneTime}" Margin="5" Visibility="{Binding IsRefreshing, Converter={StaticResource VisibleWhenTrueConverter}, Mode=OneWay}" />
                    <Button Content="{x:Bind r:Texts.Refresh, Mode=OneTime}" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource NativeCardStyle}">
                <Grid>
                    <Grid x:Name="addonsPanel" Visibility="Visible">
                        <ListView ItemsSource="{Binding VpkConflictingDetailsViewModels}" SelectionMode="None" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource NativeListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Expander HorizontalContentAlignment="Stretch" IsExpanded="False" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <views:AddonRefView DataContext="{Binding Addon}" />
                                        </Expander.Header>
                                        <details:VpkAddonConflictingDetailsView />
                                    </Expander>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Bind r:Texts.Empty, Mode=OneTime}" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding VpkConflictingDetailsViewModels.Count, Converter={StaticResource ZeroToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                    <Grid x:Name="filesPanel" Visibility="Collapsed">
                        <ListView ItemsSource="{Binding ConflictingFileWithAddonsViewModels}" SelectionMode="None" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource NativeListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Expander HorizontalContentAlignment="Stretch" IsExpanded="False" HorizontalAlignment="Stretch">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding File}" TextTrimming="CharacterEllipsis" />
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding AddonViewModels}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <views:AddonRefView />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Bind r:Texts.Empty, Mode=OneTime}" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding ConflictingFileWithAddonsViewModels, Converter={StaticResource EmptyEnumerableToVisibilityConverter}, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</host:HostedPage>