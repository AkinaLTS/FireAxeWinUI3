<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNodeSectionViewDecorator.axaml
     The Alt version filled the Border through a named child assignment in the constructor; WinUI assigns the
     same thing through Border.Child (see code-behind). -->
<UserControl
    x:Class="FireAxe.Views.AddonNodeSectionViewDecorator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="decorator"
        Margin="0,8,0,0"
        Style="{StaticResource Level1BorderStyle}" />
</UserControl>
