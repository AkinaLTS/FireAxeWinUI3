<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonNodeExplorerView.axaml.
     Avalonia constructs mapping onto WinUI 3:
       * GridSplitter (Semi theme)                  -> hand-written drag strip (see code-behind); WinUI has no
         GridSplitter in the box and no WrapPanel-style non-virtualizing panel either.
       * WrapPanel (ItemsPanel)                     -> ItemsWrapGrid for the tile view (the Avalonia tile list
         virtualized through a WrapPanel; ItemsWrapGrid is the native virtualizing equivalent). The
         non-virtualizing WrapPanel places (tags, moving bar) use Views\Controls\WrapPanel.
       * SelectionMode={Binding ExpectedSelectionMode} -> SelectionMode="Extended" plus manual
         SelectedItems <-> ViewModel.SelectedNodes synchronization (SelectedItems is not a DP in WinUI).
       * ContextMenu                                -> ContextFlyout + MenuFlyout with Click handlers; a
         flyout is not in the visual tree, so command bindings on it are unreliable, and handlers also keep
         the "click on the toolbar button" path identical.
       * DynamicResource AddonTileSize               -> Views\Controls\AddonTileMetrics (see AddonNodeTileView).
       * x:False / x:True command parameters         -> Click handlers calling DeleteCommand with the flag. -->
<UserControl
    x:Class="FireAxe.Views.AddonNodeExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:FireAxe.Views.Controls"
    xmlns:controls="using:FireAxe.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FireAxe.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    x:Name="root"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    mc:Ignorable="d"
    PointerMoved="OnRootPointerMoved"
    PointerReleased="OnPointerReleased">

    <Grid x:Name="rootGrid" SizeChanged="OnExplorerSizeChanged" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="addonNodeViewColumn" Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ============================ row 0: back / root / breadcrumb ============================ -->
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Background="Transparent"
                Click="OnGotoParentButtonClick">
                <ctl:IconView Width="25" Height="25" Data="{x:Bind local:Icons.ArrowUp, Mode=OneTime}" />
            </Button>

            <Button
                Grid.Column="1"
                Background="Transparent"
                Click="OnGotoRootButtonClick">
                <ctl:IconView Width="25" Height="25" Data="{x:Bind local:Icons.Home, Mode=OneTime}" />
            </Button>

            <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                x:Name="compactDetailsButton" Visibility="Collapsed" Click="OnToggleCompactDetails"
                Content="{x:Bind r:NativeUiTexts.Details, Mode=OneTime}" />
            <ScrollViewer
                Grid.Column="2"
                Margin="0,0,88,0"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <local:AddonNodeNavBarView />
            </ScrollViewer>
        </Grid>

        <!-- ============================ row 1: search bar + sort / view kind ============================ -->
        <Grid
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,8,0" RowSpacing="4" ColumnSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="searchTextBox" MinWidth="80" PlaceholderText="{x:Bind r:Texts.Search, Mode=OneTime}"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{x:Bind r:Texts.Search, Mode=OneTime}" />
                <Button Grid.Column="1" Click="OnClearSearchTextButtonClick"
                    AutomationProperties.Name="{x:Bind r:NativeUiTexts.ClearFilters, Mode=OneTime}"
                    ToolTipService.ToolTip="{x:Bind r:NativeUiTexts.ClearFilters, Mode=OneTime}">
                    <SymbolIcon Symbol="Clear" />
                </Button>
                <Button Grid.Column="2" x:Name="searchOptionsButton" Click="OnSearchOptionsButtonClick"
                    AutomationProperties.Name="{x:Bind r:Texts.Filter, Mode=OneTime}"
                    ToolTipService.ToolTip="{x:Bind r:Texts.Filter, Mode=OneTime}">
                    <SymbolIcon Symbol="Filter" />
                </Button>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind r:Texts.FilterEnabledMessage, Mode=OneTime}"
                        Visibility="{Binding IsFilterEnabled, Converter={StaticResource VisibleWhenTrueConverter}}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind r:Texts.SearchingMessage, Mode=OneTime}"
                        Visibility="{Binding IsSearching, Converter={StaticResource VisibleWhenTrueConverter}}" />
                </StackPanel>
            </Grid>
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                Content="{x:Bind r:NativeUiTexts.SortAndView, Mode=OneTime}">
                <Button.Flyout><Flyout>
            <StackPanel Spacing="12">
                <Grid>
                    <!-- Alt 用两个叠放的按钮切换 Ascending/Descending 文案 -->
                    <Button
                        Background="Transparent"
                        Click="OnToggleOrderDirectionButtonClick"
                        Content="{x:Bind r:Texts.Ascending, Mode=OneTime}"
                        Visibility="{Binding IsAscendingOrder, Converter={StaticResource VisibleWhenTrueConverter}}" />
                    <Button
                        Background="Transparent"
                        Click="OnToggleOrderDirectionButtonClick"
                        Content="{x:Bind r:Texts.Descending, Mode=OneTime}"
                        Visibility="{Binding IsAscendingOrder, Converter={StaticResource VisibleWhenFalseConverter}}" />
                </Grid>

                <ComboBox
                    Margin="5"
                    ItemsSource="{x:Bind local:EnumSources.AddonNodeSortMethods, Mode=OneTime}"
                    SelectedItem="{Binding SortMethod, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox
                    Margin="5"
                    ItemsSource="{x:Bind local:EnumSources.AddonNodeListItemViewKinds, Mode=OneTime}"
                    SelectedItem="{Binding ListItemViewKind, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
                </Flyout></Button.Flyout>
            </Button>
        </Grid>

        <!-- ============================ row 2: moving bar / search options / node list ============================ -->
        <Border
            Grid.Row="2"
            Grid.Column="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource NativeCardCornerRadius}">
            <Border.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Click="OnRefreshMenuClick" Text="{x:Bind r:Texts.Refresh, Mode=OneTime}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="{x:Bind r:Texts.New, Mode=OneTime}">
                        <MenuFlyoutItem Click="OnNewGroupMenuClick" Text="{x:Bind r:Texts.Group, Mode=OneTime}" />
                        <MenuFlyoutItem Click="OnNewRefAddonMenuClick" Text="{x:Bind r:Texts.ReferenceAddon, Mode=OneTime}" />
                        <MenuFlyoutItem Click="OnNewWorkshopAddonMenuClick" Text="{x:Bind r:Texts.WorkshopAddon, Mode=OneTime}" />
                        <MenuFlyoutItem Click="OnNewWorkshopCollectionMenuClick" Text="{x:Bind r:Texts.WorkshopCollection, Mode=OneTime}" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem Click="OnCreateRefAddonsBasedOnSelectedMenuClick" Text="{x:Bind r:Texts.CreateRefAddonsBasedOnSelectedAddons, Mode=OneTime}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnEnableMenuClick" Text="{x:Bind r:Texts.Enable, Mode=OneTime}" />
                    <MenuFlyoutItem Click="OnDisableMenuClick" Text="{x:Bind r:Texts.Disable, Mode=OneTime}" />
                    <MenuFlyoutItem Click="OnEnableRecursivelyMenuClick" Text="{x:Bind r:Texts.EnableRecursively, Mode=OneTime}" />
                    <MenuFlyoutItem Click="OnDisableRecursivelyMenuClick" Text="{x:Bind r:Texts.DisableRecursively, Mode=OneTime}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnMoveMenuClick" Text="{x:Bind r:Texts.Move, Mode=OneTime}" />
                    <MenuFlyoutItem Click="OnMoveHereMenuClick" Text="{x:Bind r:Texts.MoveHere, Mode=OneTime}" />
                    <MenuFlyoutItem Click="OnCancelMoveMenuClick" Text="{x:Bind r:Texts.CancelMove, Mode=OneTime}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Click="OnDeleteMenuClick" Text="{x:Bind r:Texts.Delete, Mode=OneTime}" />
                    <MenuFlyoutItem Click="OnDeleteAndRetainFileMenuClick" Text="{x:Bind r:Texts.DeleteAndRetainFile, Mode=OneTime}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="{x:Bind r:Texts.More, Mode=OneTime}">
                        <MenuFlyoutItem Click="OnSetAutoUpdateStrategyToDefaultRecursivelyMenuClick" Text="{x:Bind r:Texts.SetAutoUpdateStrategyToDefaultRecursively, Mode=OneTime}" />
                        <MenuFlyoutItem Click="OnSetAutoUpdateStrategyToEnabledRecursivelyMenuClick" Text="{x:Bind r:Texts.SetAutoUpdateStrategyToEnabledRecursively, Mode=OneTime}" />
                        <MenuFlyoutItem Click="OnSetAutoUpdateStrategyToDisabledRecursivelyMenuClick" Text="{x:Bind r:Texts.SetAutoUpdateStrategyToDisabledRecursively, Mode=OneTime}" />
                        <MenuFlyoutItem Click="OnOpenWorkshopPageMenuClick" Text="{x:Bind r:Texts.OpenWorkshopPage, Mode=OneTime}" />
                    </MenuFlyoutSubItem>
                </MenuFlyout>
            </Border.ContextFlyout>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- moving addons bar -->
                <Grid
                    Grid.Row="0"
                    Visibility="{Binding MovingNodeViewModels.Count, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="10"
                        VerticalAlignment="Center"
                        Text="{x:Bind r:Texts.MovingColon, Mode=OneTime}" />

                    <ScrollViewer
                        Grid.Column="1"
                        MaxHeight="150"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MovingNodeViewModels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="5"
                                        Padding="5"
                                        BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Inside a horizontal StackPanel the width is measured with
                                                 infinity, so AddonRefView's star column would collapse to 0
                                                 and the name would overlap the two trailing buttons.
                                                 Alt got the natural width for free from Avalonia's TextBlock;
                                                 WinUI needs an explicit width here. -->
                                            <controls:AddonRefView Width="220" ShowEnableButton="False" />
                                            <Button
                                                Background="Transparent"
                                                Command="{Binding MoveHereCommand}">
                                                <ctl:IconView
                                                    Width="15"
                                                    Height="15"
                                                    Margin="2.5,0,0,0"
                                                    Data="{x:Bind local:Icons.Checkmark, Mode=OneTime}" />
                                            </Button>
                                            <Button
                                                Background="Transparent"
                                                Click="OnRemoveMovingNodeButtonClick">
                                                <ctl:IconView Width="15" Height="15" Data="{x:Bind local:Icons.Dismiss, Mode=OneTime}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- search options panel -->
                    <Grid
                        x:Name="searchOptionsControl"
                        Grid.Column="0"
                        Visibility="Collapsed">
                        <ScrollViewer
                            Width="250"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind r:Texts.IgnoreCase, Mode=OneTime}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsChecked="{Binding SearchIgnoreCase, Mode=TwoWay}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind r:Texts.Flatten, Mode=OneTime}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsChecked="{Binding IsSearchFlatten, Mode=TwoWay}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind r:Texts.UseRegex, Mode=OneTime}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsChecked="{Binding IsSearchRegex, Mode=TwoWay}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind r:Texts.Filter, Mode=OneTime}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        IsChecked="{Binding IsFilterEnabled, Mode=TwoWay}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind r:Texts.TagFilterMode, Mode=OneTime}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        ItemsSource="{x:Bind local:EnumSources.AddonTagFilterModes, Mode=OneTime}"
                                        SelectedItem="{Binding TagFilterMode, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <StackPanel Visibility="{Binding IsFilterEnabled, Converter={StaticResource VisibleWhenTrueConverter}}">
                                    <TextBlock Margin="0,5" Text="{x:Bind r:Texts.Tags, Mode=OneTime}" />
                                    <controls:AddonTagCheckBoxList />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Column="1">
                        <!-- tile view -->
                        <ListView
                            x:Name="tileListView"
                            Padding="5"
                            IsItemClickEnabled="False"
                            ItemsSource="{Binding CurrentNodes}"
                            SelectionMode="Extended"
                            Visibility="{Binding IsTileView, Converter={StaticResource VisibleWhenTrueConverter}}"
                            SelectionChanged="OnListSelectionChanged"
                            DoubleTapped="OnItemsDoubleTapped">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="3"
                                        Padding="5"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="3"
                                        CornerRadius="5">
                                        <controls:AddonNodeTileView />
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- grid view -->
                        <ListView
                            x:Name="gridListView"
                            Padding="5"
                            IsItemClickEnabled="False"
                            ItemsSource="{Binding CurrentNodes}"
                            SelectionMode="Extended"
                            Visibility="{Binding IsGridView, Converter={StaticResource VisibleWhenTrueConverter}}"
                            SelectionChanged="OnListSelectionChanged"
                            DoubleTapped="OnItemsDoubleTapped">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <controls:AddonNodeGridRowView />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Text="{x:Bind r:Texts.Empty, Mode=OneTime}"
                            Visibility="{Binding CurrentNodes.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ column 1: splitter ============================ -->
        <Border
            x:Name="splitter"
            Grid.Row="0"
            Grid.Column="1"
            Grid.RowSpan="3"
            Width="4"
            Background="Transparent"

            PointerPressed="OnSplitterPointerPressed" />

        <!-- ============================ column 2: addon detail ============================ -->
        <Border
            x:Name="detailPane"
            Grid.Row="0"
            Grid.Column="2"
            Grid.RowSpan="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource NativeCardCornerRadius}"
>
            <Grid>
                <Border x:Name="compactDetailBackground" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <Grid Padding="16" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind r:NativeUiTexts.Details, Mode=OneTime}" />
                        <Button Grid.Column="1" x:Name="closeCompactDetailsButton" HorizontalAlignment="Right" Visibility="Collapsed" Click="OnToggleCompactDetails" AutomationProperties.Name="{x:Bind r:Texts.Cancel, Mode=OneTime}"><SymbolIcon Symbol="Cancel"/></Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource NativeSubtitleTextStyle}" Text="{x:Bind r:NativeUiTexts.SelectionHint, Mode=OneTime}" Visibility="{Binding SelectedNodes.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
                    <StackPanel Grid.Row="1"
                        Margin="0,24,0,0"
                        Visibility="{Binding IsMultipleSelection, Converter={StaticResource VisibleWhenTrueConverter}}">
                        <TextBlock
                            Margin="5"
                            HorizontalAlignment="Center"
                            Text="{Binding SelectedNodes.Count, Converter={StaticResource MultipleItemsSelectedConverter}}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="{Binding SelectionNames}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                        Margin="0"
                        Visibility="{Binding IsSingleSelection, Converter={StaticResource VisibleWhenTrueConverter}}">
                        <local:AddonNodeView x:Name="addonNodeView" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
