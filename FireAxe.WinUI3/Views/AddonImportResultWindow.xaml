<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\AddonImportResultWindow.axaml
     SelectableTextBlock -> TextBlock IsTextSelectionEnabled; DockPanel -> Grid -->
<host:HostedPage
    xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.AddonImportResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FireAxe.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    mc:Ignorable="d"
    Title="{x:Bind r:Texts.Import, Mode=OneTime}">

    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource NativePageTitleTextStyle}" Text="{x:Bind r:Texts.Import, Mode=OneTime}" />
    <Grid Grid.Row="1" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Orientation="Horizontal"
            Spacing="5"
            HorizontalAlignment="Center">
            <FontIcon
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="&#xE7BA;"
                Visibility="{x:Bind local:XBind.VisibleIf(ViewModel.ImportResult.HasFailure), Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="3">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.Details, Mode=OneWay}"
                    TextAlignment="Left" />
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</host:HostedPage>