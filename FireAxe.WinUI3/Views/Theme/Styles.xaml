<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Assets\CommonResources.axaml + the relevant styles of App.axaml.
     Avalonia class selectors (Classes="Heading1" / "PropertyName" / ...) have no WinUI equivalent, so the
     class styles become keyed styles that are applied explicitly (Style="{StaticResource ...}").
     Brushes map onto the Fluent theme where an equivalent exists (P2 §3.7, D4/R3: no pixel-level fidelity). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FireAxe.Views">

    <!-- Note: the icon geometries live in Views\Icons.cs (WinUI 3 cannot declare PathGeometry.Figures in
         XAML — WMC0055), so this dictionary only carries brushes / styles / converters. -->

    <!-- Shared P6 layout tokens. System resources follow theme and high contrast. -->
    <Thickness x:Key="NativePagePadding">24</Thickness>
    <CornerRadius x:Key="NativeCardCornerRadius">8</CornerRadius>
    <Style x:Key="NativePageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="NativeSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="NativeSectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="NativeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource NativeCardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="NativeListItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style x:Key="NativeToolButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- ============================ brushes ============================ -->

    <!-- Semantic system colors follow light, dark and high-contrast themes. -->
    <SolidColorBrush x:Key="FireAxeWarningBrush" Color="{ThemeResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="FireAxeEnableButtonStrokeBrush" Color="{ThemeResource ControlStrokeColorDefault}" />

    <!-- Avalonia: brush_background_addon_list_item_selected & friends. WinUI's ListView already paints the
         selection (Fluent accent-tinted), so these are intentionally not reproduced (R3/D4). -->

    <!-- ============================ converters ============================ -->

    <local:ImageSourceConverter x:Key="ImageSourceConverter" />
    <local:ReadableBytesConverter x:Key="ReadableBytesConverter" />
    <local:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    <local:VisibleWhenTrueConverter x:Key="VisibleWhenTrueConverter" />
    <local:VisibleWhenFalseConverter x:Key="VisibleWhenFalseConverter" />
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <local:IdInParenthesesConverter x:Key="IdInParenthesesConverter" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibilityConverter" />
    <local:EmptyEnumerableToVisibilityConverter x:Key="EmptyEnumerableToVisibilityConverter" />
    <local:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter" />
    <local:ObjectExplanationConverter x:Key="ObjectExplanationConverter" />
    <local:LocalDateTimeConverter x:Key="LocalDateTimeConverter" />
    <local:MultipleItemsSelectedConverter x:Key="MultipleItemsSelectedConverter" />

    <!-- ============================ text styles ============================ -->

    <!-- App.axaml: ":is(TextBlock).Heading1" -->
    <Style x:Key="Heading1TextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- App.axaml: ":is(TextBlock).PropertyName" -->
    <Style x:Key="PropertyNameTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,5,30,5" />
    </Style>

    <!-- App.axaml: ":is(TextBlock).PropertyValue" -->
    <Style x:Key="PropertyValueTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>

    <!-- Note: Avalonia's <SelectableTextBlock> has no WinUI counterpart; the port uses
         <TextBlock IsTextSelectionEnabled="True" /> with the same PropertyName/PropertyValue styles. -->
    <!-- ============================ container styles ============================ -->

    <!-- App.axaml: "Border.Level1" -->
    <Style x:Key="Level1BorderStyle" TargetType="Border" BasedOn="{StaticResource NativeCardStyle}" />

    <!-- CommonResources.axaml: "boxshadow_regular" (BoxShadow) -> Fluent card elevation. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>

    <!-- CommonResources.axaml: size_addon_tile{,_small,_large} = 100 / 75 / 150.
         Used by the explorer's tile view (AddonNodeExplorerViewModel.TileViewSize). -->
    <x:Double x:Key="size_addon_tile">100</x:Double>
    <x:Double x:Key="size_addon_tile_small">75</x:Double>
    <x:Double x:Key="size_addon_tile_large">150</x:Double>

</ResourceDictionary>
