<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\OperationsProgressWindow.axaml
     DockPanel -> Grid; {Binding} -> {x:Bind ViewModel.} (DataContext does not exist on WinUI 3 Window) -->
<host:HostedPage
    xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.OperationsProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:r="using:FireAxe.Resources"
    xmlns:v="using:FireAxe.Views"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource NativePageTitleTextStyle}" Text="{x:Bind r:Texts.Operations, Mode=OneTime}" />
    <Grid Grid.Row="1" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <v:OperationsProgressView x:Name="operationsProgressView" Margin="5" />

        <Button
            Grid.Row="1"
            Margin="5"
            HorizontalAlignment="Right"
            Command="{x:Bind ViewModel.CloseCommand, Mode=OneTime}"
            Content="{x:Bind r:Texts.Confirm, Mode=OneTime}" />
    </Grid>
    </Grid>
</host:HostedPage>