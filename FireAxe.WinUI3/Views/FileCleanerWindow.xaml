<?xml version="1.0" encoding="utf-8"?>
<!-- Ported from FireAxe_Alt\FireAxe.GUI\Views\FileCleanerWindow.axaml. -->
<host:HostedPage
    xmlns:host="using:FireAxe.Views" x:Class="FireAxe.Views.FileCleanerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FireAxe.Views"
    xmlns:controls="using:FireAxe.Views.Controls"
    xmlns:r="using:FireAxe.Resources"
    Title="{x:Bind r:Texts.FileCleaner, Mode=OneTime}">
    <Grid Padding="{StaticResource NativePagePadding}" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource NativePageTitleTextStyle}" Text="{x:Bind r:Texts.FileCleaner, Mode=OneTime}" />
    <Grid Grid.Row="1" Padding="0" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{x:Bind r:Texts.TotalFileSizeColon, Mode=OneTime}" />
                    <TextBlock Text="{Binding TotalFileSize, Converter={StaticResource ReadableBytesConverter}}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Bind r:Texts.RetainAll, Mode=OneTime}" Command="{x:Bind ViewModel.RetainAllCommand, Mode=OneTime}" />
                <Button Grid.Column="2" Content="{x:Bind r:Texts.DeleteAll, Mode=OneTime}" Command="{x:Bind ViewModel.DeleteAllCommand, Mode=OneTime}" />
            </Grid>
            <CheckBox Content="{x:Bind r:Texts.GlobalSearch, Mode=OneTime}" IsChecked="{x:Bind ViewModel.IsGlobalSearch, Mode=TwoWay}" />
            <StackPanel Visibility="{Binding IsGlobalSearch, Converter={StaticResource VisibleWhenFalseConverter}}" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind r:Texts.SearchSources, Mode=OneTime}" />
                    <Button Content="{x:Bind r:Texts.Add, Mode=OneTime}" Click="OnAddSourceClick" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.SourceAddonViewModels, Mode=OneWay}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <controls:AddonRefView ShowEnableButton="False" />
                                <Button Grid.Column="1" Content="×" Command="{Binding RemoveCommand}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="{x:Bind r:Texts.FindAllCleanable, Mode=OneTime}" Command="{x:Bind ViewModel.FindAllCleanableCommand, Mode=OneTime}" />
                <Button Content="{x:Bind r:Texts.FindRedundantVpkFiles, Mode=OneTime}" Command="{x:Bind ViewModel.FindRedundantVpkFilesCommand, Mode=OneTime}" />
                <Button Content="{x:Bind r:Texts.FindDownloadTempFiles, Mode=OneTime}" Command="{x:Bind ViewModel.FindDownloadTempFilesCommand, Mode=OneTime}" />
                <Button Content="{x:Bind r:Texts.FindEmptyDirectories, Mode=OneTime}" Command="{x:Bind ViewModel.FindEmptyDirectoriesCommand, Mode=OneTime}" />
            </StackPanel>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.StagedItems, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="6" Padding="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" IsTextSelectionEnabled="True" TextWrapping="Wrap" Text="{Binding RelativePath}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding FileSize, Converter={StaticResource ReadableBytesConverter}}" />
                        <Button Grid.Column="2" Loaded="OnShowFileLabelLoaded" Command="{Binding ShowInFileExplorerCommand}" />
                        <Button Grid.Column="3" Loaded="OnRetainLabelLoaded" Command="{Binding RetainCommand}" />
                        <Button Grid.Column="4" Loaded="OnDeleteLabelLoaded" Command="{Binding DeleteCommand}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Text="{x:Bind r:Texts.Empty, Mode=OneTime}" Visibility="{x:Bind local:XBind.VisibleIfEmpty(ViewModel.StagedItems.Count), Mode=OneWay}" />
    </Grid>
    </Grid>
</host:HostedPage>